{
  "name": "moonmeister-site",
  "private": true,
  "type": "module",
  "imports": {
    "#styles": "./src/styles/global.css"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "admin": "open 'http://localhost:4321/_emdash/api/setup/dev-bypass?redirect=/_emdash/admin'",
    "db:wipe": "rm -rf .wrangler/state/v3/d1 node_modules/.vite",
    "astro": "astro",
    "format": "prettier --write . --plugin-search-dir=.",
    "check:format": "prettier --check . --plugin-search-dir=.",
    "check:spell": "cspell \"./src/**/*.{astro,ts,md,css}\"",
    "check:types": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/ts-plugin": "1.10.10",
    "@emdash-cms/cloudflare": "^0.27.0",
    "@emdash-cms/plugin-atproto": "^0.2.1",
    "@moonmeister/plugin-asides": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "astro-feather": "^1.0.0",
    "emdash": "^0.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.1.1",
    "cspell": "^10.0.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "vite": "^8.1.3",
    "wrangler": "^4.107.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
